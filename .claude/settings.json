{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config --global url.\"https://$(gh auth token 2>/dev/null)@github.com/\".insteadOf \"git@github.com:\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sed -i '' '/.*insteadOf.*/d' ~/.gitconfig && sed -i '' '/url.*@github.com.*/d' ~/.gitconfig; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/soheil/projects/statusline/.claude/hooks/block-npm.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/soheil/projects/statusline/.claude/hooks/block-npx.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/soheil/projects/statusline/.claude/hooks/block-eslint.sh"
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": []
  },

  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false
  },

  "prefersReducedMotion": true
}
